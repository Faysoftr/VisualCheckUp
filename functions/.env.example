# Copy to functions/.env before running `firebase deploy --only functions`
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=visualcheckup-images
R2_PUBLIC_BASE_URL=https://cdn.your-visualcheckup-domain.com
# Optional: Google Cloud Vision API key for SafeSearch NSFW/violence image moderation
VISION_API_KEY=your_google_cloud_vision_api_key
